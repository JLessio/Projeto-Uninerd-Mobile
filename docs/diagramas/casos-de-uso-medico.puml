@startuml
title Projeto Uninerd — Casos de Uso do Médico
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Médico

rectangle "Sistema Uninerd" {
  usecase "Cadastrar conta\nprofissional" as UC01
  usecase "Autenticar-se" as UC02
  usecase "Gerenciar perfil" as UC03
  usecase "Informar foto e\nbiografia profissional" as UC04
  usecase "Configurar horários\nde atendimento" as UC05
  usecase "Selecionar dias e horários" as UC06
  usecase "Salvar disponibilidade" as UC07
  usecase "Visualizar agenda diária" as UC08
  usecase "Identificar horários\nlivres e ocupados" as UC09
  usecase "Consultar dados da consulta" as UC10
  usecase "Cancelar agendamento" as UC11
  usecase "Alternar tema" as UC12
}

Médico --> UC01
Médico --> UC02
Médico --> UC03
Médico --> UC05
Médico --> UC08
Médico --> UC10
Médico --> UC11
Médico --> UC12

UC03 .> UC04 : <<include>>
UC05 .> UC06 : <<include>>
UC05 .> UC07 : <<include>>
UC08 .> UC09 : <<include>>

note right of UC07
  A disponibilidade persistida define
  quais horários podem ser oferecidos
  aos pacientes.
end note

note right of UC08
  A agenda apresenta todos os horários
  do dia e o estado livre ou ocupado.
end note
@enduml
